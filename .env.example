# Do not add real credentials to this file or use NEXT_PUBLIC_ for secrets.

# Database
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Authentication and administrator access
AUTH_PROVIDER=
AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact callback origin; set independently per environment.
AUTH_SITE_URL=http://127.0.0.1:3012
# Keep false until the enrollment SQL is explicitly approved and applied.
MEMBERSHIP_ENROLLMENT_ENABLED=false

# Inquiry notification email
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
INQUIRY_NOTIFICATION_TO=
INQUIRY_NOTIFICATION_ENABLED=false
INQUIRY_API_ENABLED=false

# Inquiry data lifecycle
PRIVACY_POLICY_VERSION=
INQUIRY_RETENTION_DAYS=

# Search Console / Naver Search Advisor HTML verification content values.
# Optional. Leave empty until ownership verification codes are issued.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Phone is server-only. Never use NEXT_PUBLIC_ for the phone or secret.
CONTACT_PHONE_NUMBER=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
PHONE_REVEAL_ALLOWED_HOSTS=hyunjulab.com
# Enable only after real Turnstile keys and the shared rate-limit rule are configured.
PHONE_REVEAL_ENABLED=false
